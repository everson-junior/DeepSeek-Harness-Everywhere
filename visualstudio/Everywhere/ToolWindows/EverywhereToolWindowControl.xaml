<UserControl x:Class="Everywhere.ToolWindows.EverywhereToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation / Action Bar -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnStart" Content="▶ Start" Margin="0,0,4,0" Padding="8,3" Background="#0E639C" Foreground="White" BorderThickness="0" Click="BtnStart_Click" FontWeight="SemiBold" Cursor="Hand" />
                    <Button x:Name="BtnStop" Content="🛑 Stop" Margin="0,0,4,0" Padding="8,3" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnStop_Click" Cursor="Hand" />
                    <Button x:Name="BtnRestart" Content="🔄 Restart" Margin="0,0,4,0" Padding="8,3" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnRestart_Click" Cursor="Hand" />
                    <Button x:Name="BtnReload" Content="🔁 Reload" Margin="0,0,4,0" Padding="8,3" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnReload_Click" Cursor="Hand" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtStatus" Text="Stopped" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                    <Button x:Name="BtnOptions" Content="⚙" Padding="6,2" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Click="BtnOptions_Click" Cursor="Hand" ToolTip="Everywhere Settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main WebView2 Area -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebBrowser" />

            <!-- Placeholder / Initial Start Screen -->
            <Border x:Name="StartOverlay" Background="#181818" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                    <TextBlock Text="🌐 Everywhere" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="DeepSeek Harness Autonomous AI Agent" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <TextBlock x:Name="TxtOverlayError" Text="" Foreground="#F44336" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" HorizontalAlignment="Center" Visibility="Collapsed" />

                    <Button x:Name="BtnOverlayStart" Content="▶ Iniciar DeepSeek Harness" Background="#007ACC" Foreground="White" Padding="12,8" FontWeight="SemiBold" BorderThickness="0" Click="BtnStart_Click" Cursor="Hand" Margin="0,0,0,8" />
                    <Button x:Name="BtnOverlayStop" Content="🛑 Parar Serviço Anterior" Background="#333333" Foreground="#CCCCCC" Padding="12,6" BorderThickness="0" Click="BtnStop_Click" Cursor="Hand" Margin="0,0,0,12" />

                    <TextBlock Text="O agente interage diretamente com o código e arquivos da sua solução atual." FontSize="10" Foreground="#666666" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
