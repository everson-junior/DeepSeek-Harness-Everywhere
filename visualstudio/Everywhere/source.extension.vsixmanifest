<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="Everywhere.DeepSeek.VSIX" Version="0.1.0" Language="en-US" Publisher="Everywhere" />
    <DisplayName>Everywhere - DeepSeek Harness for Visual Studio</DisplayName>
    <Description xml:space="preserve">Connect Visual Studio 2022 to the official DeepSeek Harness autonomous AI agent runtime. Full tool calling, autonomous workspace inspection and live reasoning in your IDE.</Description>
    <MoreInfo>https://github.com/everson-junior/DeepSeek-Harness-Everywhere</MoreInfo>
    <Icon>Resources/Icon.png</Icon>
    <PreviewImage>Resources/Preview.png</PreviewImage>
    <Tags>deepseek, harness, ai, agent, reasoner, v3, r1, autonomous, coding</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, )">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0, )" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="Everywhere.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="Everywhere.dll" />
  </Assets>
</PackageManifest>
