<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>false</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>Everywhere</RootNamespace>
    <AssemblyName>Everywhere</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension Condition="'$(Configuration)' == 'Debug'">true</DeployExtension>
    <ExtensionInstallationRoot>CommonExtensions</ExtensionInstallationRoot>
    <ExtensionInstallationFolder>Everywhere</ExtensionInstallationFolder>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Authors>EverDock</Authors>
    <Company>EverDock</Company>
    <Product>Everywhere (DeepSeek Harness)</Product>
    <Description>Run official DeepSeek Harness autonomous AI agents directly inside Visual Studio 2022.</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" />
    <None Include="LICENSE">
      <IncludeInVSIX>true</IncludeInVSIX>
    </None>
    <None Include="Resources\Icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </None>
    <None Include="Resources\Preview.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </None>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="EverywherePackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.527" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.11.435" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
  </ItemGroup>
</Project>
